struct VertexInput {
	@location(0) position: vec3f,
	@location(1) texcoord: vec2f,
	@location(2) normal: vec3f
};

struct VertexOutput {
	@builtin(position) position: vec4f,
	@location(1) texcoord: vec2f,
	@location(2) normal: vec3f,
	@location(3) color: vec4f,
	@location(4) fragPos: vec3f
};

struct Uniforms {
    projection: mat4x4<f32>,
	view: mat4x4<f32>,
	env: mat4x4<f32>,
    model: mat4x4<f32>,    
	normal: mat4x4<f32>,
	color: vec4<f32>,
	camPos: vec3<f32>,
	lightVP:mat4x4<f32>,
	shadow: mat4x4<f32>,
	lightPos: vec3<f32>
};

struct Instance {
    model : mat4x4<f32>,
	color : vec4<f32>,
}

struct Instances {
    instances : array<Instance>,
}

struct Light {
    position: vec3f,
    color: vec4f,
};

struct Lights {
    lights : array<Light>,
}

@group(0) @binding(0) var<uniform> uniforms: Uniforms;
@group(0) @binding(1) var<storage, read> strg : Instances;
@group(0) @binding(2) var smplr: sampler;
@group(0) @binding(3) var texture: texture_2d<f32>;
@group(0) @binding(4) var<storage, read> lights: Lights;

@vertex
fn vs_main(in: VertexInput, @builtin(instance_index) instanceIndex : u32) -> VertexOutput {
	let instance = strg.instances[instanceIndex];
	
	var out: VertexOutput;
	out.position = uniforms.projection * uniforms.view * instance.model * vec4f(in.position, 1.0);
	out.normal = (instance.model * vec4f(in.normal, 0.0)).xyz;
	out.texcoord = in.texcoord;
	out.color = instance.color;
	out.fragPos = (instance.model * vec4f(in.position, 1.0)).xyz;
	return out;
}

struct PassOutput {
  @location(0) brightness : vec4f,
  @location(1) color : vec4f, 
}

@fragment
fn fs_main(in: VertexOutput) -> PassOutput {

	let color = textureSample(texture, smplr, in.texcoord).rgb * in.color.rgb;
    let normal = normalize(in.normal);
	
	let ambient = 0.0 * color;
    var lighting = vec3f(0.0);
    let viewDir = normalize(uniforms.camPos - in.fragPos);
	
	for(var i = 0; i < 4; i++){
		let light = lights.lights[i];
		
		let lightDir = normalize(light.position - in.fragPos);
		let diff = max(dot(lightDir, normal), 0.0);
        var result = light.color.rgb * diff * color;  
		
		let distance = length(in.fragPos - light.position);
        result *= 1.0 / (distance * distance);
        lighting += result;
	}
	
	let result = ambient + lighting;
    let brightness = dot(result, vec3f(0.2126, 0.7152, 0.0722));

	var output : PassOutput;
	
	output.color = vec4f(result, 1.0);
	output.brightness = select(vec4f(0.0, 0.0, 0.0, 1.0), vec4f(result, 1.0), brightness > 1.0);
	
	return output;
}struct VertexOutput {
    @builtin(position) position: vec4f,
    @location(0) texcoord: vec2f,
};

@vertex
fn vs_main(@builtin(vertex_index) vertexIndex: u32) -> VertexOutput {
    var positions = array<vec2f, 6>(
        vec2f(-1.0, -1.0), vec2f( 1.0, -1.0), vec2f(-1.0,  1.0),
        vec2f(-1.0,  1.0), vec2f( 1.0, -1.0), vec2f( 1.0,  1.0)
    );
    var texcoords = array<vec2f, 6>(
        vec2f(0.0, 1.0), vec2f(1.0, 1.0), vec2f(0.0, 0.0),
        vec2f(0.0, 0.0), vec2f(1.0, 1.0), vec2f(1.0, 0.0)
    );

    var out: VertexOutput;
    out.position = vec4f(positions[vertexIndex], 0.0, 1.0);
    out.texcoord = texcoords[vertexIndex];
    return out;
}

struct CompositeUniforms {
    exposure: f32,
    bloomStrength: f32,
};

@group(0) @binding(0) var smplr: sampler;
@group(0) @binding(1) var sceneTexture: texture_2d<f32>;
@group(0) @binding(2) var bloomTexture: texture_2d<f32>;
@group(0) @binding(3) var<uniform> uniforms: CompositeUniforms;

fn bloom_new(texcoord: vec2f) -> vec3f {
    let hdrColor = textureSample(sceneTexture, smplr, texcoord).rgb;
    let bloomColor = textureSample(bloomTexture, smplr, texcoord).rgb;
    return mix(hdrColor, bloomColor, uniforms.bloomStrength);
}

@fragment
fn fs_main(in: VertexOutput) -> @location(0) vec4f {
    var result = bloom_new(in.texcoord);
    result = vec3f(1.0) - exp(-result * uniforms.exposure);
    const gamma = 2.2;
    result = pow(result, vec3f(1.0 / gamma)); 
    return vec4f(result, 1.0);
}struct VertexOutput {
    @builtin(position) position: vec4<f32>,
    @location(0) texCoord: vec2<f32>,
};

@vertex
fn vs_main(@builtin(vertex_index) vertexIndex: u32) -> VertexOutput {
    var out: VertexOutput;
    // Generiert ein bildschirmfÃ¼llendes Dreieck aus dem Index (0, 1, 2)
    let uv = vec2<f32>(f32((vertexIndex << 1u) & 2u), f32(vertexIndex & 2u));
    out.position = vec4<f32>(uv * 2.0 - 1.0, 0.0, 1.0);
    out.texCoord = vec2<f32>(uv.x, 1.0 - uv.y); // Y-Achse fÃ¼r WebGPU flippen
    return out;
}

struct DownsampleUniforms {
    srcResolution: vec2<f32>,
    mipLevel: u32,
};

@group(0) @binding(0) var srcSampler: sampler;
@group(0) @binding(1) var srcTexture: texture_2d<f32>;
@group(0) @binding(2) var<uniform> uniforms: DownsampleUniforms;

fn ToSRGB(v: vec3<f32>) -> vec3<f32> {
    return pow(v, vec3<f32>(1.0 / 2.2));
}

fn sRGBToLuma(col: vec3<f32>) -> f32 {
    return dot(col, vec3<f32>(0.299, 0.587, 0.114));
}

fn KarisAverage(col: vec3<f32>) -> f32 {
    let luma = sRGBToLuma(ToSRGB(col)) * 0.25;
    return 1.0 / (1.0 + luma);
}

@fragment
fn fs_main(input: VertexOutput) -> @location(0) vec4<f32> {
    let texDims = textureDimensions(srcTexture, 0); 
    
    //let srcTexelSize = vec2<f32>(1.0 / f32(texDims.x), 1.0 / f32(texDims.y));	
	let srcTexelSize = 1.0 / uniforms.srcResolution;
    let x = srcTexelSize.x;
    let y = srcTexelSize.y;
    let uv = input.texCoord;

    let a = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x - 2.0*x, uv.y + 2.0*y)).rgb;
    let b = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x,       uv.y + 2.0*y)).rgb;
    let c = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x + 2.0*x, uv.y + 2.0*y)).rgb;

    let d = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x - 2.0*x, uv.y)).rgb;
    let e = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x,       uv.y)).rgb;
    let f = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x + 2.0*x, uv.y)).rgb;

    let g = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x - 2.0*x, uv.y - 2.0*y)).rgb;
    let h = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x,       uv.y - 2.0*y)).rgb;
    let i = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x + 2.0*x, uv.y - 2.0*y)).rgb;

    let j = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x - x, uv.y + y)).rgb;
    let k = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x + x, uv.y + y)).rgb;
    let l = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x - x, uv.y - y)).rgb;
    let m = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x + x, uv.y - y)).rgb;

    var downsample: vec3<f32>;

    if (uniforms.mipLevel == 0u) {
        var groups: array<vec3<f32>, 5>;
        groups[0] = (a + b + d + e) * (0.125 / 4.0);
        groups[1] = (b + c + e + f) * (0.125 / 4.0);
        groups[2] = (d + e + g + h) * (0.125 / 4.0);
        groups[3] = (e + f + h + i) * (0.125 / 4.0);
        groups[4] = (j + k + l + m) * (0.5 / 4.0);

        groups[0] *= KarisAverage(groups[0]);
        groups[1] *= KarisAverage(groups[1]);
        groups[2] *= KarisAverage(groups[2]);
        groups[3] *= KarisAverage(groups[3]);
        groups[4] *= KarisAverage(groups[4]);

        downsample = groups[0] + groups[1] + groups[2] + groups[3] + groups[4];
        downsample = max(downsample, vec3<f32>(0.0001));
    } else {
        downsample = e * 0.125;
        downsample += (a + c + g + i) * 0.03125;
        downsample += (b + d + f + h) * 0.0625;
        downsample += (j + k + l + m) * 0.125;
    }

    return vec4<f32>(downsample, 1.0);
}struct VertexOutput {
    @builtin(position) position: vec4<f32>,
    @location(0) texCoord: vec2<f32>,
};

@vertex
fn vs_main(@builtin(vertex_index) vertexIndex: u32) -> VertexOutput {
    var out: VertexOutput;
    if (vertexIndex == 0u) {
        out.position = vec4<f32>(-1.0, -1.0, 0.0, 1.0);
        out.texCoord = vec2<f32>(0.0, 1.0); 
    } else if (vertexIndex == 1u) {
        out.position = vec4<f32>(3.0, -1.0, 0.0, 1.0);
        out.texCoord = vec2<f32>(2.0, 1.0);
    } else {
        out.position = vec4<f32>(-1.0, 3.0, 0.0, 1.0);
        out.texCoord = vec2<f32>(0.0, -1.0);
    }
    return out;
}

struct UpsampleUniforms {
    filterRadius: f32,
};

@group(0) @binding(0) var srcSampler: sampler;
@group(0) @binding(1) var srcTexture: texture_2d<f32>;
@group(0) @binding(2) var<uniform> uniforms: UpsampleUniforms;

@fragment
fn fs_main(input: VertexOutput) -> @location(0) vec4<f32> {
    let x = uniforms.filterRadius;
    let y = uniforms.filterRadius;
    let uv = input.texCoord;

    let a = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x - x, uv.y + y)).rgb;
    let b = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x,     uv.y + y)).rgb;
    let c = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x + x, uv.y + y)).rgb;

    let d = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x - x, uv.y)).rgb;
    let e = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x,     uv.y)).rgb;
    let f = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x + x, uv.y)).rgb;

    let g = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x - x, uv.y - y)).rgb;
    let h = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x,     uv.y - y)).rgb;
    let i = textureSample(srcTexture, srcSampler, vec2<f32>(uv.x + x, uv.y - y)).rgb;

    var upsample = e * 4.0;
    upsample += (b + d + f + h) * 2.0;
    upsample += (a + c + g + i);
    upsample *= 1.0 / 16.0;

    return vec4<f32>(upsample, 1.0);
}‰PNG
